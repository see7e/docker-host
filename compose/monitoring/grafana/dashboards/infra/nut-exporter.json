    {
      "datasource": {
        "type": "prometheus",
        "uid": "bfu9ng8flfvuoa"
      },
      "description": "Current NUT UPS status. OL=online, OB=on battery, LB=low battery.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "1": {
                  "color": "green",
                  "text": "Online"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "Not Online"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
